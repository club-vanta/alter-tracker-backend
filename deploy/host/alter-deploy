#!/bin/bash
# Entry point for deploys. cloud-init installs it as /usr/local/bin/alter-deploy
# and lets the Oracle Cloud Agent user (ocarun) run it with sudo, nothing else.
#
# Usage: sudo alter-deploy <full 40-char commit sha>
#
# Downloads the repo at that commit and runs its scripts/deploy.sh, so the
# compose file and deploy logic always match the commit being deployed.
# Changes to this file need a new instance (or a manual copy): it lives
# outside the release directories on purpose, as the one fixed piece.

set -euo pipefail

REPO="club-vanta/alter-tracker-backend"
RELEASES="/opt/alter-tracker/releases"

sha="${1:-}"
if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Usage: alter-deploy <full 40-char commit sha>" >&2
  exit 2
fi

# GitHub serves any commit of the fork network under this repo's URLs, so a
# sha alone proves nothing. Only commits in main's history may run, which
# holds even if the deployer key leaks. "behind" is an older main commit
# (rollback), "identical" is main's head.
status="$(curl -fsS --retry 3 "https://api.github.com/repos/$REPO/compare/main...$sha" | jq -r .status)"
if [[ "$status" != "identical" && "$status" != "behind" ]]; then
  echo "Cannot deploy $sha: it is not in the history of main (compare status: $status)." >&2
  exit 1
fi

release_dir="$RELEASES/$sha"
if [[ ! -d "$release_dir" ]]; then
  mkdir -p "$RELEASES"
  tmp="$(mktemp -d "$RELEASES/.download.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL --retry 3 "https://codeload.github.com/$REPO/tar.gz/$sha" |
    tar -xz -C "$tmp" --strip-components=1
  mv "$tmp" "$release_dir"
  trap - EXIT
fi

# Commits from before the OCI migration have an AWS-only deploy.sh.
if [[ ! -f "$release_dir/deploy/host/alter-deploy" ]]; then
  echo "Cannot deploy $sha: it predates the OCI deploy scripts. Deploy a newer commit." >&2
  exit 1
fi

exec "$release_dir/scripts/deploy.sh" "$sha" "$release_dir"
